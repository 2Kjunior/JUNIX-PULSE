{
  "expo": {
    "name": "Junix Pulse",
    "slug": "junix-pulse",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "junixpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.junix.pulse"
    },
    "android": {
      "package": "com.junix.pulse",
      "adaptiveIcon": {
        "backgroundColor": "#141317",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#8B5CF6",
          "sounds": [
            "./assets/sounds/junix_pulse_notification.wav"
          ],
          "androidChannels": [
            {
              "name": "junix-pulse-reminders-v2",
              "channelName": "Rappels Junix Pulse",
              "importance": "high",
              "sound": "junix_pulse_notification.wav",
              "vibrate": true,
              "lightColor": "#8B3DF0",
              "showBadge": false
            }
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Autoriser Junix Pulse à accéder à vos contacts pour importer vos proches."
        }
      ],
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Autoriser Junix Pulse à utiliser Face ID pour ouvrir votre Sanctuaire."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "react-native-quick-crypto",
      "expo-background-task",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Autoriser Junix Pulse à utiliser le micro pour dicter une capture rapide.",
          "speechRecognitionPermission": "Autoriser Junix Pulse à reconnaître la parole, sur le téléphone uniquement.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Autoriser Junix Pulse à lire votre agenda pour afficher vos rendez-vous à côté de vos rappels."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser Junix Pulse à utiliser Face ID pour déverrouiller l’application."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Junix Pulse",
              "description": "Pulse, votre prochain rappel et les tâches du jour",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd574275-c52c-495f-9516-9dc2881b9974"
      }
    },
    "owner": "2k_junior"
  }
}
